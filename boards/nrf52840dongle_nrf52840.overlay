/* ---------- PWM0: 4 servos on CH0..CH3 ---------- */
&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;    /* required 'default' state */
    pinctrl-1 = <&pwm0_sleep>;      /* required 'sleep' state   */
    pinctrl-names = "default", "sleep";
};

/* ---------- PWM1: 1 servo on CH0 ---------- */
&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_default>;    /* required 'default' state */
    pinctrl-1 = <&pwm1_sleep>;      /* required 'sleep' state   */
    pinctrl-names = "default", "sleep";
};

/* ---------- Consolidated pinctrl definitions ---------- */
&pinctrl {
    /* PWM0 default: CH0→P0.13, CH1→P0.15, CH2→P0.17, CH3→P0.24 (updated) */
    pwm0_default: pwm0_default {
        group1 {
            psels = <
                NRF_PSEL(PWM_OUT0, 0, 13)   /* pwm0 ch0 -> P0.13 (Servo 1) */
                NRF_PSEL(PWM_OUT1, 0, 15)   /* pwm0 ch1 -> P0.15 (Servo 2) */
                NRF_PSEL(PWM_OUT2, 0, 17)   /* pwm0 ch2 -> P0.17 (Servo 3) */
                NRF_PSEL(PWM_OUT3, 0, 24)   /* pwm0 ch3 -> P0.24 (Servo 4) */
            >;
        };
    };

    /* PWM0 sleep: same pins */
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <
                NRF_PSEL(PWM_OUT0, 0, 13)
                NRF_PSEL(PWM_OUT1, 0, 15)
                NRF_PSEL(PWM_OUT2, 0, 17)
                NRF_PSEL(PWM_OUT3, 0, 24)   /* updated */
            >;
            low-power-enable;
        };
    };

    /* PWM1 default: CH0→P0.22 */
    pwm1_default: pwm1_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 22)>;  /* pwm1 ch0 -> P0.22 (Servo 5) */
        };
    };

    /* PWM1 sleep: same pin + low power */
    pwm1_sleep: pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 22)>;
            low-power-enable;
        };
    };
};
